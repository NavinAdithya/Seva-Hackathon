{
  "expo": {
    "name": "SignSOS",
    "slug": "signsos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "signsos",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.signsos.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0F19"
      },
      "package": "com.signsos.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-localization"
    ]
  }
}
